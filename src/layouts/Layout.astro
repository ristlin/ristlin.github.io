---
import '../styles/global.css';
import { SITE, NAV, SOCIALS } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

// Person JSON-LD for Knowledge Graph attribution to the name + role.
// Intentionally OMITS worksFor so the structured data does not associate the
// page with the current employer brand in SERPs.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: 'B2B Marketing and Communications Executive',
  url: SITE.url,
  address: {
    '@type': 'PostalAddress',
    addressRegion: SITE.location,
    addressCountry: 'US',
  },
  sameAs: SOCIALS.filter((s) => s.href.startsWith('http')).map((s) => s.href),
  alumniOf: [
    {
      '@type': 'EducationalOrganization',
      name: 'Georgetown University',
    },
    {
      '@type': 'EducationalOrganization',
      name: 'Quantic School of Business and Technology',
    },
  ],
  knowsAbout: [
    'B2B Marketing',
    'Marketing Communications',
    'Demand Generation',
    'Brand Strategy',
    'Marketing Operations',
    'Content Marketing',
    'HubSpot CRM',
    'Trade Show Marketing',
    'AI-assisted Marketing',
    'Sustainability in Engineering',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content={SITE.twitterHandle} />
    <meta name="twitter:site" content={SITE.twitterHandle} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />


    {/* Set theme before paint to avoid a flash of the wrong color scheme. */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:shadow dark:focus:bg-neutral-900"
    >
      Skip to content
    </a>

    <header
      class="sticky top-0 z-40 border-b border-neutral-200/70 bg-white/80 backdrop-blur dark:border-neutral-800/70 dark:bg-neutral-950/80"
    >
      <nav
        class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-3"
      >
        <a href="#top" class="font-semibold tracking-tight no-underline">
          Yuse<span class="text-accent">.</span>
        </a>
        <div class="flex items-center gap-1 sm:gap-4">
          <ul class="hidden items-center gap-4 text-sm sm:flex">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-neutral-600 no-underline transition-colors hover:text-accent dark:text-neutral-400"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
            class="rounded-md p-2 text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-accent dark:text-neutral-400 dark:hover:bg-neutral-800"
          >
            <svg
              class="hidden h-5 w-5 dark:block"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.5-6.5-1.5 1.5M6.5 17.5 5 19m13.5.5-1.5-1.5M6.5 6.5 5 5M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"
              ></path>
            </svg>
            <svg
              class="block h-5 w-5 dark:hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
              ></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-neutral-200 dark:border-neutral-800">
      <div class="mx-auto max-w-3xl px-5 py-8">
        <p class="text-xs text-neutral-500">
          © {year} {SITE.name}. Built with Astro.
        </p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
