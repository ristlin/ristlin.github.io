---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { SITE, SOCIALS, SKILLS, LEADERSHIP } from '../consts';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const education = (await getCollection('education')).sort(byOrder);
const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort(byOrder);

// Publications grouped by category, in display order.
type Pub = CollectionEntry<'publications'>;
const publications = (await getCollection('publications')).sort(byOrder);
const pubGroups: { key: Pub['data']['category']; label: string; items: Pub[] }[] = [
  { key: 'trade', label: 'Trade publications', items: [] },
  { key: 'writing', label: 'Selected writing', items: [] },
  { key: 'research', label: 'Research', items: [] },
];
for (const p of publications) {
  pubGroups.find((g) => g.key === p.data.category)?.items.push(p);
}

const emailLink = SOCIALS.find((s) => s.label === 'Email')!;
const primaryLinks = SOCIALS.filter((s) =>
  ['Email', 'LinkedIn'].includes(s.label),
);
const secondaryLinks = SOCIALS.filter((s) => s.label !== 'Email');
---

<Layout>
  {/* Hero */}
  <section id="top" class="mx-auto max-w-3xl px-5 pb-4 pt-16 sm:pt-24">
    <p class="mb-3 text-sm font-medium text-accent">{SITE.location}</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      Yuse Lajiminmuhip.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-neutral-600 dark:text-neutral-300">
      {SITE.tagline}
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      {
        primaryLinks.map((link, i) => (
          <a
            href={link.href}
            rel={link.href.startsWith('http') ? 'me noopener' : undefined}
            class={
              i === 0
                ? 'rounded-md bg-accent px-4 py-2 text-sm font-medium text-white no-underline transition-opacity hover:opacity-90'
                : 'rounded-md border border-neutral-300 px-4 py-2 text-sm font-medium no-underline transition-colors hover:border-accent hover:text-accent dark:border-neutral-700'
            }
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </section>

  {/* About */}
  <Section id="about" title="About">
    <div class="space-y-4 text-neutral-700 dark:text-neutral-300">
      <p>
        B2B marketing and communications executive. 15+ years across
        industrial manufacturing, publishing, and technology. Currently Head
        of Marketing and Outreach at AGRU America. Cofounded Tunnyl in 2015.
      </p>
      <p>
        Publications, industry leadership roles, and selected projects are
        below. Full CV available on request, or via
        <a
          href="https://www.linkedin.com/in/yuselajiminmuhip/"
          rel="me noopener"
          class="text-accent">LinkedIn</a>.
      </p>
    </div>
  </Section>

  {/* Publications */}
  {
    publications.length > 0 && (
      <Section id="publications" title="Publications">
        <div class="space-y-10">
          {pubGroups
            .filter((g) => g.items.length > 0)
            .map((group) => (
              <div>
                <h3 class="mb-4 text-sm font-semibold text-neutral-800 dark:text-neutral-200">
                  {group.label}
                </h3>
                <ul class="space-y-5">
                  {group.items.map((pub) => (
                    <li>
                      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                        <p class="font-medium">
                          {pub.data.url ? (
                            <a
                              href={pub.data.url}
                              rel="noopener"
                              class="no-underline transition-colors hover:text-accent"
                            >
                              {pub.data.title}
                              <span class="text-accent"> ↗</span>
                            </a>
                          ) : (
                            pub.data.title
                          )}
                        </p>
                        <p class="font-mono text-xs text-neutral-500">
                          {pub.data.date}
                        </p>
                      </div>
                      <p class="mt-0.5 text-sm text-neutral-500">
                        {pub.data.venue}
                        {pub.data.coauthors.length > 0 &&
                          ` · with ${pub.data.coauthors.slice(0, 3).join(', ')}${pub.data.coauthors.length > 3 ? ` and ${pub.data.coauthors.length - 3} others` : ''}`}
                      </p>
                      {pub.data.summary && (
                        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
                          {pub.data.summary}
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
        </div>
      </Section>
    )
  }

  {/* Industry Leadership */}
  <Section id="leadership" title="Industry leadership">
    <ul class="space-y-5">
      {
        LEADERSHIP.map((item) => (
          <li>
            <p class="font-medium">{item.title}</p>
            {item.detail && (
              <p class="mt-0.5 text-sm text-neutral-600 dark:text-neutral-400">
                {item.detail}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  {/* Skills */}
  <Section id="skills" title="Skills">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        SKILLS.map((group) => (
          <div>
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">
              {group.category}
            </h3>
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li class="rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  {/* Projects */}
  {
    projects.length > 0 && (
      <Section id="projects" title="Highlights">
        <div class="grid gap-5 sm:grid-cols-2">
          {projects.map((project) => (
            <article class="rounded-lg border border-neutral-200 p-5 transition-colors hover:border-accent dark:border-neutral-800">
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-semibold">{project.data.name}</h3>
                {project.data.year && (
                  <span class="font-mono text-xs text-neutral-500">
                    {project.data.year}
                  </span>
                )}
              </div>
              {project.data.role && (
                <p class="mt-0.5 text-xs text-neutral-500">
                  {project.data.role}
                </p>
              )}
              <p class="mt-3 text-sm text-neutral-700 dark:text-neutral-300">
                {project.data.blurb}
              </p>
              {project.data.stack.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-1.5">
                  {project.data.stack.map((tech) => (
                    <li class="rounded bg-neutral-100 px-2 py-0.5 font-mono text-[11px] text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400">
                      {tech}
                    </li>
                  ))}
                </ul>
              )}
              {project.data.links.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-4 text-sm">
                  {project.data.links.map((link) => (
                    <a
                      href={link.url}
                      rel="noopener"
                      class="text-accent"
                    >
                      {link.label} →
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </Section>
    )
  }

  {/* Education */}
  <Section id="education" title="Education & credentials">
    <ul class="space-y-6">
      {
        education.map((item) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-4">
            <div>
              <p class="font-medium">{item.data.credential}</p>
              <p class="text-sm text-neutral-500">{item.data.institution}</p>
            </div>
            <p class="font-mono text-xs text-neutral-500">{item.data.year}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* Contact */}
  <Section id="contact" title="Get in touch">
    <p class="max-w-xl text-neutral-700 dark:text-neutral-300">
      Email reaches me fastest. Open to conversations on B2B marketing,
      manufacturing go-to-market, sustainability in geosynthetics, or
      whatever I’m building.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a
        href={emailLink.href}
        class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-medium text-white no-underline transition-opacity hover:opacity-90"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 7.5 12 13l9-5.5M4.5 6h15a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5v-9A1.5 1.5 0 0 1 4.5 6Z"
          ></path>
        </svg>
        {SITE.email}
      </a>
      <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {
          secondaryLinks.map((s) => (
            <li>
              <a
                href={s.href}
                rel={s.href.startsWith('http') ? 'me noopener' : undefined}
                class="text-neutral-600 transition-colors hover:text-accent dark:text-neutral-400"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</Layout>
