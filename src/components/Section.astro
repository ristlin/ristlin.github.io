---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} class="border-t border-neutral-200 dark:border-neutral-800">
  <div class="mx-auto max-w-3xl px-5 py-12 sm:py-16">
    <h2
      class="mb-8 text-xs font-semibold uppercase tracking-[0.18em] text-neutral-500"
    >
      {title}
    </h2>
    <slot />
  </div>
</section>
